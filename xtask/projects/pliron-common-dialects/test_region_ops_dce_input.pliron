builtin.module @test_module {
  ^entry():
    llvm.func @dead_ops: llvm.func <builtin.fp32 (builtin.integer i64, builtin.integer i1) variadic = false> [] {
      ^entry(n : builtin.integer i64, cond : builtin.integer i1):
